# URL e chave publicável de um projeto Supabase próprio para este app.
# A chave publicável é destinada ao navegador; nunca use a chave secret/service_role aqui.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-publicavel
# Chave pública do widget Turnstile. Configure a chave secreta correspondente no Supabase.
VITE_TURNSTILE_SITE_KEY=
# Defina após decidir o preço e o recebedor Pix; estes valores aparecem no frontend.
VITE_ACCESS_PRICE_BRL=
VITE_PAYMENT_PIX_KEY=
VITE_PAYMENT_RECIPIENT=
